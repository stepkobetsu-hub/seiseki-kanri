<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#EEF4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STEP過去問スキャナー"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#145DA0"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="学校・年度などを選んでから、紙をスキャンします。PDF化して過去問DBへ直接登録します。"
            android:textSize="14sp"
            android:textColor="#475569"
            android:paddingBottom="16dp" />

        <TextView style="@style/FieldLabel" android:text="担当者" />
        <EditText
            android:id="@+id/teacher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例：加瀬"
            android:inputType="textPersonName"
            android:background="@drawable/field_bg"
            android:padding="12dp" />

        <TextView style="@style/FieldLabel" android:text="学校" />
        <Spinner android:id="@+id/school" style="@style/FieldSpinner" />

        <TextView style="@style/FieldLabel" android:text="学年" />
        <Spinner android:id="@+id/grade" style="@style/FieldSpinner" />

        <TextView style="@style/FieldLabel" android:text="科目" />
        <Spinner android:id="@+id/subject" style="@style/FieldSpinner" />

        <TextView style="@style/FieldLabel" android:text="年度" />
        <Spinner android:id="@+id/year" style="@style/FieldSpinner" />

        <TextView style="@style/FieldLabel" android:text="回" />
        <Spinner android:id="@+id/exam" style="@style/FieldSpinner" />

        <TextView style="@style/FieldLabel" android:text="種類" />
        <Spinner android:id="@+id/kind" style="@style/FieldSpinner" />

        <TextView
            android:id="@+id/fileNamePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#EFF6FF"
            android:padding="12dp"
            android:textColor="#1D4ED8"
            android:textStyle="bold"
            android:text="ファイル名：" />

        <Button
            android:id="@+id/scanButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="① 文書をスキャン"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#145DA0" />

        <TextView
            android:id="@+id/scanStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:text="まだスキャンしていません"
            android:textStyle="bold"
            android:textColor="#475569"
            android:background="#FFFFFF" />

        <Button
            android:id="@+id/uploadButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="② 過去問DBへ登録"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E85D04"
            android:enabled="false" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#334155" />
    </LinearLayout>
</ScrollView>
